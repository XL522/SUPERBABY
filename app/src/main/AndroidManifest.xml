<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.chords">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/square"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- 所有子 Activity：exported="false" -->
        <activity android:name=".min_e" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".min_b" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".min_as" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".min_a" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".min_gs" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".min_g" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".min_fs" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".min_f" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".min_ds" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".min_d" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".min_cs" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".min_c" android:screenOrientation="portrait" android:exported="false"/>

        <activity android:name=".maj_b" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".maj_as" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".maj_a"
            android:configChanges="orientation|screenSize"
            android:exported="true" />
        <activity android:name=".maj_gs" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".maj_g" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".maj_fs" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".maj_f" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".maj_e" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".maj_ds" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".maj_d" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".maj_cs" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".maj_c" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".PianoActivity"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize" />
        <activity android:name=".min_intent" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".maj_intent" android:screenOrientation="portrait" android:exported="false"/>

        <!-- 主入口：必须 exported="true" -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>